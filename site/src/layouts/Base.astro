---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  /** Marks the current top-level nav item. */
  current?: "home" | "docs";
}

const { title, description, current } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const card = Astro.site ? new URL(url("/og.png"), Astro.site).href : url("/og.png");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#111214" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href={url("/llms.txt")} title="llms.txt" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Copy buttons on code blocks (lib/highlight.ts): the icon becomes a tick,
      // and the note inside the button tells a screen reader what happened.
      document.addEventListener("click", async (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
        if (!button) return;
        const scope = button.closest("[data-code]");
        const text = button.dataset.copy || scope?.querySelector("pre")?.textContent || "";
        const note = button.querySelector(".copy-note");
        const say = (state: string, words: string) => {
          button.dataset.state = state;
          if (note) note.textContent = words;
        };
        try {
          await navigator.clipboard.writeText(text.trimEnd());
          say("copied", "Copied");
        } catch {
          // The text is selected instead, ready for the keyboard.
          say("failed", "Press Ctrl+C");
          const pre = scope?.querySelector("pre");
          if (pre) getSelection()?.selectAllChildren(pre);
        }
        setTimeout(() => {
          delete button.dataset.state;
          if (note) note.textContent = "";
        }, 1600);
      });

      // Tabs (`[data-tabs]`, on the landing page): click or arrow keys move the
      // selection, one panel shows.
      for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
        const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const select = (tab: HTMLButtonElement, focus = false) => {
          for (const t of tabs) {
            const on = t === tab;
            t.setAttribute("aria-selected", String(on));
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
          }
          if (focus) tab.focus();
        };
        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => select(tab));
          tab.addEventListener("keydown", (e) => {
            const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
            if (!step) return;
            e.preventDefault();
            select(tabs[(i + step + tabs.length) % tabs.length], true);
          });
        });
      }
    </script>
  </body>
</html>
