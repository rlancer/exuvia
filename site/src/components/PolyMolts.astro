---
// The hero's art, a low-poly model (src/lib/poly.ts): the lobster, and four
// of the animals that wore a shell like it long before there were lobsters,
// oldest first. Every form has the same triangles in the same order, so one
// morphs into the next by moving its corners. A form the animal has left
// stays behind as a wireframe: an empty shell.
---

<button
  class="poly"
  type="button"
  data-poly
  aria-label="Low-poly model of a blue lobster. Above it, in outline, are four older shelled animals it morphs through, oldest first: Waptia from the Cambrian, the phyllocarid Ceratiocaris from the Silurian, the early decapod Palaeopalaemon from the Devonian and the early lobster Eryma from the Jurassic. Select to replay."
>
  <canvas></canvas>
  <span class="probe" aria-hidden="true"><i data-ink></i><i data-shade></i><i data-shell></i></span>
</button>

<style>
  .poly {
    /* The animal's colour, the colour of its facets in shadow, and the line
       of an empty shell. */
    --poly-ink: var(--running);
    --poly-shade: #1c2c5e;
    --poly-shell: var(--muted);
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 100 / 88;
  }
  .probe {
    display: none;
  }
  [data-ink] {
    color: var(--poly-ink);
  }
  [data-shade] {
    color: var(--poly-shade);
  }
  [data-shell] {
    color: var(--poly-shell);
  }
</style>

<script>
  import { STAGES, build, extent, painter, sway, tone } from "../lib/poly";

  const HEADING = Math.PI + 0.28; // head to the left, turned a little toward the viewer
  const [HOLD_FIRST, MORPH, HOLD] = [0.9, 0.9, 0.7];
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const clamp = (t: number) => Math.min(1, Math.max(0, t));

  function start(root: HTMLElement) {
    const canvas = root.querySelector("canvas")!;
    const ctx = canvas.getContext("2d")!;
    const meshes = STAGES.map(build);
    const paint = painter(ctx, meshes[0]);
    const blend = new Float32Array(meshes[0].v.length);
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mono = getComputedStyle(root).getPropertyValue("--mono") || "monospace";

    // Colours come from the page's tokens, read off the probe elements.
    const ink = tone(root, "ink");
    const shade = tone(root, "shade");
    const shell = `rgb(${tone(root, "shell").join(",")})`;

    function label(text: string, x: number, y: number, alpha: number) {
      if (alpha <= 0) return;
      ctx.globalAlpha = alpha;
      ctx.fillStyle = shell;
      ctx.fillText(text, x, y);
      ctx.globalAlpha = 1;
    }

    // How much room each animal takes, seen from the resting angle.
    const boxes = meshes.map((mesh) => extent(mesh.v, [HEADING]));

    /** One frame, `t` seconds into the sequence and `life` seconds since the model first showed. */
    function draw(t: number, life: number) {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const ratio = Math.min(2, devicePixelRatio || 1);
      if (canvas.width !== Math.round(width * ratio) || canvas.height !== Math.round(height * ratio)) {
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
      }
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);
      const unit = width / 20;
      const yaw = HEADING + (still ? 0 : sway(life));

      ctx.font = `${Math.max(10, Math.min(12, width / 36))}px ${mono}`;
      ctx.textAlign = "center";
      ctx.textBaseline = "top";

      // The shells: a row along the top, oldest first, each named by its age.
      const past = boxes.slice(0, -1);
      const gap = 1.1;
      const span = past.reduce((sum, box) => sum + box.right - box.left, 0) + gap * (past.length - 1);
      const small = Math.min(unit * 0.62, (width * 0.96) / span);
      let x = (width - span * small) / 2;
      past.forEach((box, i) => {
        const shown = clamp((t - (HOLD_FIRST + i * (MORPH + HOLD))) / 0.6);
        paint.place(meshes[i].v, yaw, small, x - box.left * small, height * 0.14 - ((box.top + box.bottom) / 2) * small);
        paint.shell(shell, shown);
        label(STAGES[i].age, x + ((box.right - box.left) * small) / 2, height * 0.27, shown);
        x += (box.right - box.left + gap) * small;
      });

      // The animal: whichever form it has reached, or part way to the next.
      const step = Math.max(0, t - HOLD_FIRST) / (MORPH + HOLD);
      const from = Math.min(STAGES.length - 1, Math.floor(step));
      const to = Math.min(STAGES.length - 1, from + 1);
      const mix = ease(clamp(((step - from) * (MORPH + HOLD)) / MORPH));
      const [a, b] = [meshes[from].v, meshes[to].v];
      for (let i = 0; i < blend.length; i++) blend[i] = a[i] + (b[i] - a[i]) * mix;
      paint.place(blend, yaw, unit, width * 0.51, height * 0.66);
      paint.solid(ink, shade);
      // Its name changes hands half way through a morph.
      const now = STAGES[mix < 0.5 ? from : to];
      label(`${now.name}, ${now.age}`, width / 2, height * 0.94, clamp(Math.abs(mix - 0.5) * 2.4));
    }

    const END = HOLD_FIRST + (STAGES.length - 1) * (MORPH + HOLD);
    let began = 0; // when the sequence last started
    let born = 0; // when the model first showed
    let frame = 0;
    function tick(now: number) {
      if (!born) born = began = now;
      draw((now - began) / 1000, (now - born) / 1000);
      frame = requestAnimationFrame(tick);
    }
    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
    };

    if (still) {
      // No motion: the last frame, redrawn when the canvas changes size.
      new ResizeObserver(() => draw(END + 1, 0)).observe(canvas);
      return;
    }
    // Runs only while the model is on screen.
    new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !frame) frame = requestAnimationFrame(tick);
      if (!visible) stop();
    }).observe(canvas);
    root.addEventListener("click", () => (began = performance.now()));
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-poly]")) start(root);
</script>
