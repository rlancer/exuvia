---
// One analysis done three ways with a model: asked of a chat, built by a
// coding agent as an app of its own, and built in exuvia. The panels and
// their drawing styles are the triptych in src/styles/global.css.

// The chat's answer, and the views' charts.
const bars = [14, 24, 10, 19, 13];

// A coding agent leaves one app per analysis, each with both halves.
const apps = ["vol-app/", "risk-app/", "flows-app/"];
const appY = (i: number) => 50 + i * 76;

// exuvia: three nodes down the left, two views on the right, and one node's
// stored outputs along the bottom, one per run date.
const nodes = ["prices.py", "returns.py", "summary.sql"];
const nodeY = (i: number) => 52 + i * 52;
const views = [
  { name: "views/board/", y: 92 },
  { name: "views/report/", y: 150 },
];
const dates = ["11-16", "11-17", "11-18", "11-19", "11-20"];
---

<ol class="stages">
  <li>
    <svg viewBox="0 0 320 284" role="img" aria-labelledby="wf-chat">
      <title id="wf-chat">
        A chat: a question, two tool calls and an answer with a small chart. Tomorrow it is a new chat that starts
        from nothing.
      </title>
      <g class="tab">
        <rect x="12" y="10" width="134" height="24"></rect>
        <text x="20" y="27">one conversation</text>
      </g>
      <rect class="cell" x="118" y="48" width="190" height="30"></rect>
      <text class="code" x="128" y="68">vol by sector this week?</text>
      {
        [92, 122].map((y) => (
          <g class="call">
            <rect x="12" y={y} width="176" height="24" />
            <text x="22" y={y + 16}>→ query the warehouse</text>
          </g>
        ))
      }
      <rect class="cell" x="12" y="158" width="230" height="74"></rect>
      <text class="code" x="22" y="178">Tech moved the most: …</text>
      {bars.map((h, i) => <rect class="mark" x={22 + i * 16} y={222 - h} width="11" height={h} />)}
      <path class="thread" d="M12,250 H308"></path>
      <text class="faint" x="12" y="270">tomorrow: a new chat, from scratch</text>
    </svg>
    <h3>AI chat</h3>
    <p class="what">A model with connectors to your data.</p>
    <p>
      You have an answer in a minute. But the model can only assemble what fits in one conversation, and nothing it
      did can be run again: ask tomorrow and it starts over.
    </p>
  </li>

  <li>
    <svg viewBox="0 0 320 284" role="img" aria-labelledby="wf-agent">
      <title id="wf-agent">
        Three analyses built by a coding agent: three separate apps, each with its own backend and its own front
        end.
      </title>
      <defs>
        <marker id="wf-tip" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto">
          <path d="M0 0.5 7.5 4 0 7.5z"></path>
        </marker>
      </defs>
      <g class="tab">
        <rect x="12" y="10" width="206" height="24"></rect>
        <text x="20" y="27">three analyses, three apps</text>
      </g>
      {
        apps.map((name, i) => (
          <g>
            <rect class="kernel" x="12" y={appY(i)} width="296" height="66" />
            <text class="faint" x="22" y={appY(i) + 17}>{name}</text>
            <rect class="cell" x="22" y={appY(i) + 26} width="118" height="30" />
            <text class="code" x="32" y={appY(i) + 46}>backend</text>
            <path class="arc" marker-end="url(#wf-tip)" d={`M140,${appY(i) + 41} L177,${appY(i) + 41}`} />
            <rect class="cell" x="180" y={appY(i) + 26} width="118" height="30" />
            <text class="code" x="190" y={appY(i) + 46}>front end</text>
          </g>
        ))
      }
    </svg>
    <h3>A coding agent</h3>
    <p class="what">A full code workflow, built from nothing.</p>
    <p>
      The analysis is as strong as code can make it. But each one becomes an app of its own, with a backend that
      loads the data and a front end that shows it. And it shows only now: last week's numbers are gone.
    </p>
  </li>

  <li class="now">
    <svg viewBox="0 0 320 284" role="img" aria-labelledby="wf-exuvia">
      <title id="wf-exuvia">
        An exuvia project: an agent working on a graph of three nodes, two views that read the nodes' outputs, and
        one node's stored outputs, one for each of five run dates.
      </title>
      <defs>
        <marker id="wf-tip-now" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto">
          <path d="M0 0.5 7.5 4 0 7.5z"></path>
        </marker>
      </defs>
      <g class="tab">
        <rect x="12" y="10" width="98" height="24"></rect>
        <text x="20" y="27">one project</text>
      </g>
      <path class="arc" marker-end="url(#wf-tip-now)" d="M71,85 L71,101"></path>
      <path class="arc" marker-end="url(#wf-tip-now)" d="M71,137 L71,153"></path>
      <path class="arc" marker-end="url(#wf-tip-now)" d="M135,119 L187,119"></path>
      <path class="arc" marker-end="url(#wf-tip-now)" d="M135,171 L187,171"></path>
      {
        nodes.map((name, i) => (
          <g>
            <rect class="shed" x="22" y={nodeY(i) + 6} width="110" height="30" />
            <rect class="shed" x="19" y={nodeY(i) + 3} width="110" height="30" />
            <rect class="cell" x="16" y={nodeY(i)} width="110" height="30" />
            <rect class="state" x="16" y={nodeY(i)} width="6" height="30" />
            <text class="code" x="30" y={nodeY(i) + 20}>{name}</text>
          </g>
        ))
      }
      {
        views.map((view) => (
          <g class="view">
            <rect class="cell" x="190" y={view.y} width="118" height="44" />
            <rect class="bar" x="190" y={view.y} width="118" height="9" />
            <text class="code" x="198" y={view.y + 30}>{view.name}</text>
          </g>
        ))
      }
      <g class="agent" transform="translate(190 44)">
        <path d="M0,12 L-61,22"></path>
        <rect x="0" y="0" width="64" height="24"></rect>
        <text x="32" y="17" text-anchor="middle">agent</text>
      </g>
      <text class="faint" x="16" y="224">summary.sql, one output per run date</text>
      {
        dates.map((date, i) => (
          <g class={i === dates.length - 1 ? "run latest" : "run"}>
            <rect x={16 + i * 59} y="234" width="53" height="30" />
            <text x={42.5 + i * 59} y="254" text-anchor="middle">{date}</text>
          </g>
        ))
      }
    </svg>
    <h3>exuvia</h3>
    <p class="what">One graph, every run kept, views on top.</p>
    <p>
      The agent writes the same code, as nodes in one graph. Any node runs again by hand or on a schedule, each run
      date keeps its own output, and a view is front-end files over those outputs, with no backend to write.
    </p>
  </li>
</ol>

<style>
  .faint {
    fill: var(--faint);
  }
  .call rect {
    fill: none;
    stroke: var(--faint);
    stroke-width: 1.2;
    stroke-dasharray: 2 3;
  }
  .call text {
    fill: var(--muted);
  }
  .mark {
    fill: var(--muted);
  }
  .run rect {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.2;
  }
  .run text {
    fill: var(--muted);
  }
  .run.latest rect {
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .run.latest text {
    fill: var(--text);
  }
</style>
