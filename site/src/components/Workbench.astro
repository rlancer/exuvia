---
import { Image } from "astro:assets";
import workbench from "../assets/shots/workbench.png";
import data from "../assets/shots/data.png";
import notebook from "../assets/shots/notebook.png";
import views from "../assets/shots/views.png";
import agent from "../assets/shots/agent.png";
import history from "../assets/shots/history.png";
import share from "../assets/shots/share.png";

// Real screenshots of `exuvia serve` on the example project (tools/capture.mjs),
// shown in the app's own colours.
const tabs = [
  {
    id: "graph",
    label: "Graph and data",
    image: workbench,
    alt: "The exuvia workbench. On the left the graph in three stages, Ingest, Features and Reports, all fresh. In the middle the selected node, rolling_vol, on its Data tab: the data's shape and size, a chart of 20-day volatility for eight tickers, and every row under it with each column's missing values, min and max.",
    caption:
      "The canvas is the project. Select a node to see its code, every run it has had, every version of its code, and its data: its chart over every row, whether there are ten or ten million.",
  },
  {
    id: "data",
    label: "Ask the rows",
    image: data,
    alt: "rolling_vol's Data tab after a filter in words: AAPL, MSFT and NVDA since July 2026. Under the box, the SQL condition the model wrote; the chart draws those three tickers since July, and the table holds 324 of 3,824 rows.",
    caption:
      "Say which rows you want and the model writes the SQL condition, in plain sight under the box. Or type SQL, filter a column, sort, or brush the chart: each reads the whole output, not a preview.",
  },
  {
    id: "notebook",
    label: "Notebook",
    image: notebook,
    alt: "The Notebook layout: the graph's contents down the left, stages over their nodes, and rolling_vol's cell with its description, what it reads, its chart and its rows. Its code is open in the inspector on the right.",
    caption:
      "The same graph, read top to bottom as a notebook: stages are sections, each node a cell with its description, chart and rows. Reading order is not run order, so there is no hidden state to restart.",
  },
  {
    id: "agent",
    label: "The agent at work",
    image: agent,
    alt: "The workbench after an agent turn. The agent panel shows the request, the run of drawdown, the agent noticing a stray index column and fixing it, then a summary. The new drawdown node is selected in the Features stage, with its chart of each ticker's drawdown over its rows.",
    caption:
      "Asked for a drawdown node, the agent wrote it, ran it, noticed a stray index column in the output and fixed it, then put the node in its stage. It is on the canvas with its chart.",
  },
  {
    id: "views",
    label: "Views",
    image: views,
    alt: "A view named Volatility board: three summary tiles, a table of sectors ranked by average volatility, and a line chart for the selected sector.",
    caption:
      "A view is your own React UI over node outputs. It runs in a sandboxed frame and can read only the nodes it names.",
  },
  {
    id: "history",
    label: "Code history",
    image: history,
    alt: "The History tab of rolling_vol: two saved versions, and a diff against the earlier one that swaps an inline calculation for a helper imported from lib/stats.py.",
    caption:
      "Every save of a node, a view or a helper is kept, by you or by the agent. See what each one changed, and restore any of them.",
  },
  {
    id: "share",
    label: "Sharing",
    image: share,
    alt: "The Share dialog for a project on a hub: an access request to approve, three people with their roles, general access set to only people added here, and a link that opens a view as an app.",
    caption:
      "On a hub, each project is shared the way a document is: viewers, editors, read-only links, and requests to answer.",
  },
];
---

<section class="workbench reverse" id="workbench">
  <div class="wrap">
    <header>
      <h2>One command opens the workbench</h2>
      <p>
        <code>exuvia serve</code> starts the UI, the API and the scheduler on your machine. These are screenshots of
        it running the example project, and of a hub serving it to a team.
      </p>
    </header>

    <div class="viewer" data-tabs>
      <div class="tablist" role="tablist" aria-label="Screenshots">
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
      {
        tabs.map((tab, i) => (
          <figure role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={i !== 0}>
            <div class="frame">
              <Image
                src={tab.image}
                alt={tab.alt}
                widths={[720, 1200, 1800, 2400]}
                sizes="(max-width: 1240px) 94vw, 1168px"
                loading="lazy"
                quality={82}
              />
            </div>
            <figcaption>{tab.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .workbench {
    padding: clamp(4rem, 9vw, 7rem) 0;
  }
  header {
    max-width: 46rem;
  }
  h2 {
    font-size: var(--step-3);
  }
  header p {
    max-width: 44rem;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  header code {
    color: var(--text);
  }
  .viewer {
    margin-top: 2.5rem;
  }
  .tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* Tabs as the app's segmented control: the selected one is in the accent. */
  [role="tab"] {
    padding: 0.35rem 1rem 0.4rem;
    border: var(--border-strong);
    border-radius: 0.45rem;
    background: transparent;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
  }
  [role="tab"]:hover {
    background: var(--panel);
  }
  [role="tab"][aria-selected="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }
  figure {
    margin: 1rem 0 0;
  }
  .frame {
    border: var(--border-strong);
    border-radius: 0.6rem;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    max-width: 46rem;
    margin-top: 0.9rem;
    color: var(--muted);
  }
</style>

