---
// Temporary: a bar for flipping between the designs and the hero art under
// review (src/lib/designs.ts). Each choice is kept in localStorage and
// mirrored in the address (`?design=`, `?art=`), so a link opens the same one. Delete this component, the
// script in Base.astro's <head> and the unused stylesheets once one is chosen.
import { CHOICES } from "../lib/designs";
---

<div class="design-switcher" data-design-switcher>
  {
    CHOICES.map((choice) => (
      <div role="group" aria-label={choice.label}>
        <span>{choice.label}</span>
        {choice.options.map((option, i) => (
          <button
            type="button"
            data-set={choice.key}
            data-id={option.id}
            data-default={i === 0 ? "" : undefined}
            aria-pressed="false"
            title={option.note}
          >
            {option.label}
          </button>
        ))}
      </div>
    ))
  }
</div>

<style is:global>
  /* Sized in px and set in the system font on purpose: the bar must look the
     same whichever variation is showing. */
  .design-switcher {
    position: fixed;
    left: 50%;
    bottom: 14px;
    z-index: 200;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 10px;
    width: max-content;
    max-width: calc(100vw - 16px);
    padding: 4px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 22px;
    background: rgba(18, 18, 20, 0.94);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    color: #fff;
    font: 500 13px/1 system-ui, -apple-system, "Segoe UI", sans-serif;
    letter-spacing: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .design-switcher div {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .design-switcher span {
    padding: 0 6px 0 10px;
    color: rgba(255, 255, 255, 0.6);
  }
  .design-switcher button {
    padding: 8px 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .design-switcher button:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .design-switcher button[aria-pressed="true"] {
    background: #fff;
    color: #121214;
  }
  .design-switcher button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  @media (max-width: 520px) {
    .design-switcher span {
      display: none;
    }
    .design-switcher button {
      padding: 8px 10px;
    }
  }
  @media print {
    .design-switcher {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-set]")];
  // A pressed button is the one whose choice is on <html>, or the default
  // (the site as shipped) when nothing is.
  const show = () => {
    for (const b of buttons) {
      const now = root.dataset[b.dataset.set!];
      b.setAttribute("aria-pressed", String(now ? b.dataset.id === now : "default" in b.dataset));
    }
  };
  for (const button of buttons) {
    button.addEventListener("click", () => {
      const { set: key, id } = button.dataset as { set: string; id: string };
      if ("default" in button.dataset) delete root.dataset[key];
      else root.dataset[key] = id;
      try {
        localStorage.setItem("exuvia-" + key, id);
      } catch {
        /* private mode: the choice lasts for this page only */
      }
      const here = new URL(location.href);
      here.searchParams.set(key, id);
      history.replaceState(null, "", here);
      show();
    });
  }
  show();
</script>
