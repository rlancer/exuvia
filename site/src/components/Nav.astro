---
import Mark from "./Mark.astro";
import { url } from "../lib/paths";
import { GITHUB, PYPI } from "../lib/project";

interface Props {
  current?: "home" | "docs";
}
const { current } = Astro.props;

// On a page with the sea behind it (src/components/Sea.astro) the bar is the
// top of the water: blue glass at the surface that darkens on the way down,
// with a gauge that reads how deep the page has been scrolled. Anywhere else
// it is the plain dark bar, and the gauge is not shown.
---

<header class="nav">
  <div class="wrap bar">
    <a class="brand" href={url("/")} aria-label="exuvia home">
      <Mark size={23} />
      <span>exuvia</span>
    </a>
    <span class="gauge" aria-hidden="true" data-gauge>
      <svg viewBox="0 0 10 10" width="10" height="10"><path d="M1 2.5h8L5 8.5z"></path></svg>
      <span>surface</span>
    </span>
    <nav aria-label="Site">
      <a href={url("/#evolution")} data-covers="evolution">Why a graph</a>
      <a href={url("/#node")} data-covers="node workbench views history">How it works</a>
      <a class="storage-link" href={url("/#storage")} data-covers="storage">Storage</a>
      <a class="ai-link" href={url("/#ai")} data-covers="agent ai">With AI</a>
      <a class="docs-link" href={url("/docs/")} aria-current={current === "docs" ? "page" : undefined}>Docs</a>
      <a href={PYPI} rel="noopener">PyPI</a>
    </nav>
    <a class="github" href={GITHUB} rel="noopener" aria-label="exuvia on GitHub" title="exuvia on GitHub">
      <!-- The GitHub mark (github.com/logos). -->
      <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
    <a class="btn btn-primary start" href={url("/docs/getting-started/")}>Get started</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    /* How far down the page is, from 0 at the surface to 1 in the dark. The
       script below keeps it; a page with no sea is always at 1. */
    --deep: 1;
    border-bottom: 1px solid color-mix(in srgb, rgb(111 155 255 / 0.45), var(--line) calc(var(--deep) * 100%));
    background: color-mix(in srgb, rgb(20 34 76 / 0.5), var(--bar) calc(var(--deep) * 100%));
    backdrop-filter: blur(10px) saturate(1.4);
  }
  :global(body:has(.sea)) .nav {
    --deep: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  /* The claw gives a nip when the brand is pointed at. */
  .brand :global(.mark) {
    transform-origin: 25% 80%;
    transition: rotate 0.16s ease-out;
  }
  .brand:hover :global(.mark) {
    rotate: -14deg;
  }
  .gauge {
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem 0.25rem;
    border: 1px solid color-mix(in srgb, rgb(111 155 255 / 0.4), var(--line) calc(var(--deep) * 100%));
    border-radius: 99px;
    color: color-mix(in srgb, #b9cdff, var(--muted) calc(var(--deep) * 100%));
    font-family: var(--mono);
    font-size: 0.85rem;
    line-height: 1.2;
    white-space: nowrap;
  }
  :global(body:has(.sea)) .gauge {
    display: inline-flex;
  }
  .gauge path {
    fill: var(--running);
  }
  nav {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
    font-size: 1.05rem;
    font-weight: 500;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  /* The section being read. */
  nav a[aria-current="location"] {
    text-decoration-color: var(--accent);
  }
  /* Sits between the links and Get started; the nav's gap already spaces it. */
  .github {
    display: inline-flex;
    margin-left: -0.35rem;
    padding: 0.35rem;
    border-radius: 0.4rem;
    color: var(--muted);
  }
  .github:hover,
  .github:focus-visible {
    color: var(--text);
  }
  .github path {
    fill: currentColor;
  }
  .start {
    padding: 0.45rem 0.95rem;
    font-size: 1rem;
  }
  /* The first link to go when the bar gets tight. */
  @media (max-width: 1060px) {
    nav .storage-link {
      display: none;
    }
  }
  @media (max-width: 960px) {
    nav .ai-link {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .bar {
      gap: 1rem;
    }
    nav a:not(.docs-link) {
      display: none;
    }
  }
  @media (max-width: 480px) {
    :global(body:has(.sea)) .gauge {
      display: none;
    }
  }
</style>

<script>
  // Only a page with the sea has anything to follow.
  const bar = document.querySelector<HTMLElement>(".nav");
  if (bar && document.querySelector(".sea")) {
    const reading = bar.querySelector<HTMLElement>("[data-gauge] span")!;
    const links = [...bar.querySelectorAll<HTMLAnchorElement>("a[data-covers]")];
    const sections = [...document.querySelectorAll<HTMLElement>("main > section")];
    // The bottom of the page is 480 m down, about as deep as lobsters are found.
    const FLOOR = 480;
    const smooth = (t: number) => t * t * (3 - 2 * t);

    let waiting = false;
    const follow = () => {
      waiting = false;
      const reach = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const depth = Math.min(1, Math.max(0, scrollY / reach));
      // The light goes at the same rate as the water's does.
      bar.style.setProperty("--deep", smooth(Math.min(1, depth * 2.4)).toFixed(3));
      const metres = Math.round(depth * FLOOR);
      reading.textContent = metres <= 0 ? "surface" : metres >= FLOOR ? "sea floor" : `${metres} m`;

      // The section under the bar, and the link that covers it.
      const line = bar.offsetHeight + innerHeight * 0.3;
      const here = sections.filter((section) => section.getBoundingClientRect().top < line).pop();
      for (const link of links) {
        const covers = !!here?.id && link.dataset.covers!.split(" ").includes(here.id);
        covers ? link.setAttribute("aria-current", "location") : link.removeAttribute("aria-current");
      }
    };
    const queue = () => {
      if (!waiting) requestAnimationFrame(follow);
      waiting = true;
    };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    follow();
  }
</script>
