---
// Storage as the product's data lake: every run's output kept as Parquet, in
// the project or a bucket of yours, and readable with SQL from anywhere. What
// it says is the README's "Storage" section (exuvia/artifacts.py,
// partitioned.py, keys.py, storage.py, dataapi.py).
import { Image } from "astro:assets";
import Compare from "./Compare.astro";
import storage from "../assets/shots/storage.png";
import { codeFigure, getHighlighter } from "../lib/highlight";
import { url } from "../lib/paths";

const h = await getHighlighter();

// A bucket listing as `EXUVIA_ARTIFACT_STORE` fills it: one file per output,
// named by its content. prices is partitioned: compacted years, then a file a
// day. rolling_vol keeps every run's output beside the current one.
const listing = [
  { kind: "dir", name: "s3://analytics/exuvia/markets/" },
  { kind: "dir", name: "prices/", depth: 1 },
  { kind: "file", name: "…", note: "one file for each year before", depth: 2 },
  { kind: "file", name: "3f9a…c2.parquet", note: "2024, compacted", depth: 2 },
  { kind: "file", name: "b1e4…07.parquet", note: "2025, compacted", depth: 2 },
  { kind: "file", name: "6d20…9a.parquet", note: "2026-11-26", depth: 2 },
  { kind: "file", name: "c81e…7f.parquet", note: "2026-11-27, tonight's run", depth: 2, now: true },
  { kind: "dir", name: "rolling_vol/", depth: 1 },
  { kind: "file", name: "7c1e…09.parquet", note: "run of 11-26, still readable", depth: 2 },
  { kind: "file", name: "a2f4…5b.parquet", note: "run of 11-27, current", depth: 2, now: true },
  { kind: "dir", name: "sector_summary/", depth: 1 },
];

const query = codeFigure(
  h,
  `-- From your own app, with a read-only data API key:
-- one query across two projects' outputs.
select s.sector, avg(v.vol_20d) as vol, sum(p.pnl) as pnl
from "markets".rolling_vol v
join "markets".universe s using (ticker)
join "desk".pnl p using (ticker)
group by 1`,
  "sql",
);

const points = [
  {
    title: "Every run, kept",
    body: "Each run's output is a Parquet file named by its content. A new run never overwrites the last, and exuvia never deletes an output, so last month's numbers are still there to open, query or download.",
  },
  {
    title: "Your bucket, or the project's disk",
    body: "Point <code>EXUVIA_ARTIFACT_STORE</code> at S3, R2 or MinIO and the bucket holds every output, under a prefix of its own. Nothing else in the bucket is touched.",
  },
  {
    title: "Histories that grow a day at a time",
    body: "A partitioned node adds the rows of each run to one history: a day replaces that day, a backfill fills ten years in one call, and a merge updates rows by key.",
  },
  {
    title: "No row twice",
    body: "Declare a key and every output is checked against it before it is stored, across the whole history. A run that would double a sum fails, and the last good output stays.",
  },
  {
    title: "Compacted as it grows",
    body: "A daily history would become thousands of small files. exuvia merges each year's files into one once there are too many, without changing the output or making anything stale.",
  },
  {
    title: "SQL over all of it",
    body: "DuckDB reads every node's output as a table: in the workbench, in the agent's tools, in views, and through a data API that joins projects for your own apps, in JSON or Arrow.",
  },
];

const lakeComparison = [
  ["Getting data in", "Ingestion jobs to write, schedule and watch", "A node returns rows, and its schedule runs it"],
  ["File layout", "Partitions, file sizes and compaction jobs to tune", "A partition column, compacted as it grows"],
  ["Duplicates", "Found later, in a total that came out double", "A key, checked before anything is stored"],
  ["Last month's numbers", "Snapshots, until a retention job removes them", "Every run's output, kept"],
  ["Which code made a table", "A lineage tool, wired up after the fact", "Recorded on every run, with the inputs it read"],
  ["Querying it", "A catalog and a query engine to run", "DuckDB over every output, and a data API across projects"],
];
---

<section class="lake" id="storage">
  <div class="wrap">
    <header>
      <h2>A data lake that fills itself</h2>
      <p>
        Every run of every node leaves its output behind as Parquet, on disk or in your own bucket, beside the code
        and the inputs that made it. Query any of it with SQL, from the workbench or from your own apps. There is no
        table format to choose, no catalog to run and no job that copies results somewhere they can be read: the
        pipeline that computes the data is the lake that keeps it.
      </p>
    </header>

    <div class="split">
      <figure class="bucket">
        <div class="listing mono" role="img" aria-label="A bucket listing: prices has one compacted file per year and one file a day, the newest from tonight's run; rolling_vol keeps the output of the run before beside the current one.">
          {
            listing.map((row) => (
              <div class:list={[row.kind, { now: row.now }]} style={`--depth: ${row.depth ?? 0}`}>
                <span class="name">{row.name}</span>
                {row.note && <span class="note">{row.note}</span>}
              </div>
            ))
          }
        </div>
        <Fragment set:html={query} />
        <figcaption>
          One file per output, named by its content, and one query across projects. The data API's keys are
          read-only and never reach further than the person who made them.
        </figcaption>
      </figure>

      <ul class="points">
        {
          points.map((point) => (
            <li>
              <h3>{point.title}</h3>
              <p set:html={point.body} />
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="shot">
      <div class="frame">
        <Image
          src={storage}
          alt="The Storage page of the example project: every node's outputs on disk, the current one and those kept from earlier runs, with rows and compression; the Parquet files' rows, row groups and codecs; the partitioned prices output against its compaction limit; and the records' counts of runs and code versions."
          widths={[720, 1200, 1800, 2400]}
          sizes="(max-width: 1240px) 94vw, 1168px"
          loading="lazy"
          quality={82}
        />
      </div>
      <figcaption>
        Storage, in the Settings tab, says what the project keeps: each node's current output and the ones kept from earlier runs,
        Parquet compression from the files' footers, and how close each history is to its next compaction.
      </figcaption>
    </figure>

    <Compare label="exuvia beside a data lake you assemble" columns={["A lake you assemble", "exuvia"]} rows={lakeComparison} />
    <p class="aside">
      How it is stored, where, and every way to read it: <a href={url("/docs/storage/")}>Storage</a>.{" "}
      <a href={url("/docs/partitioned-nodes/")}>Partitioned nodes</a> and <a href={url("/docs/keys/")}>keys</a> cover
      histories that grow, and the{" "}
      <a href={url("/docs/hub/#data-api-read-only-keys-for-your-own-apps")}>data API</a>{" "}
      reading it from your own apps.
    </p>
  </div>
</section>

<style>
  .lake {
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: var(--border);
    background: var(--band);
  }
  header {
    max-width: 46rem;
  }
  h2 {
    font-size: var(--step-3);
  }
  header p {
    max-width: 46rem;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 2rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .bucket {
    display: grid;
    gap: 1rem;
    margin: 0;
  }
  .listing {
    padding: 0.9rem 1.1rem;
    border: var(--border-strong);
    border-radius: 0.6rem;
    background: var(--bg-deep);
    font-size: 0.95rem;
    line-height: 1.5;
    overflow-x: auto;
  }
  .listing div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    padding: 0.15rem 0 0.15rem calc(var(--depth) * 1.4rem);
  }
  .listing .dir .name {
    color: var(--text);
    font-weight: 700;
  }
  .listing .file .name {
    color: var(--muted);
  }
  .listing .note {
    color: var(--faint);
    font-family: var(--sans);
  }
  .listing .now .name {
    color: var(--accent-hover);
  }
  .listing .now .note {
    color: var(--text);
  }
  .bucket :global(.code) {
    margin: 0;
  }
  .bucket figcaption {
    color: var(--muted);
  }

  .points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    padding: 0.9rem 0 1.2rem;
    border-top: var(--border);
  }
  .points h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .points p {
    margin-top: 0.25rem;
    color: var(--muted);
  }
  .points :global(code) {
    color: var(--text);
  }

  .shot {
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
  }
  .frame {
    border: var(--border-strong);
    border-radius: 0.6rem;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot figcaption {
    max-width: 46rem;
    margin-top: 0.9rem;
    color: var(--muted);
  }

  .aside {
    max-width: 46rem;
    margin-top: 1.75rem;
    color: var(--muted);
  }
  .aside a {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 1100px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .bucket {
      max-width: 40rem;
    }
  }
  @media (max-width: 640px) {
    .points {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
