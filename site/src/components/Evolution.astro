---
import { SWAY, build, extent, stage } from "../lib/poly";

// The same five steps of one analysis, drawn the way each tool holds them.
const steps = ["universe", "prices", "returns", "rolling_vol", "summary"];
const cellY = (i: number) => 52 + i * 44;
// Jupyter execution counters, deliberately out of order: `universe` was
// re-run after `prices` read it, and `summary` ran before `rolling_vol` did.
const counters = [7, 2, 3, 9, 4];

// marimo: dependency arcs down the right-hand side of the cells.
const arcs = [
  { from: 0, to: 1, reach: 24 },
  { from: 1, to: 2, reach: 24 },
  { from: 2, to: 3, reach: 24 },
  { from: 3, to: 4, reach: 24 },
  { from: 0, to: 4, reach: 78 },
];

// exuvia: the steps as nodes on a canvas.
const W = 120;
const H = 34;
const placed: Record<string, [number, number]> = {
  universe: [16, 48],
  prices: [178, 48],
  returns: [178, 112],
  rolling_vol: [178, 176],
  summary: [16, 176],
};
const wires = [
  "M136,65 L175,65", // universe -> prices
  "M238,82 L238,109", // prices -> returns
  "M238,146 L238,173", // returns -> rolling_vol
  "M178,193 L139,193", // rolling_vol -> summary
  "M76,82 L76,173", // universe -> summary
  "M76,216 L76,233", // summary -> the view
  "M238,216 L238,233", // rolling_vol -> the view
];
// The view under the graph: a window with a small chart in it.
const bars = [10, 16, 7, 13, 9];

// Above each tool, an animal from the lobster's line (src/lib/poly.ts), the
// same low-poly models as the hero: two older, smaller forms in grey, then
// the lobster in its blue. `size` is how big each is drawn beside the lobster.
const REST = -0.28; // head to the right, turned a little toward the viewer
const animals = [
  { name: "Waptia", size: 0.64 },
  { name: "Palaeopalaemon", size: 0.8 },
  { name: "Homarus", size: 1 },
].map((animal) => {
  const { age } = stage(animal.name);
  const box = extent(build(stage(animal.name)).v, [REST - SWAY, REST, REST + SWAY]);
  const [wide, tall] = [(box.right - box.left) * animal.size, (box.bottom - box.top) * animal.size];
  return { ...animal, age, wide, tall };
});
// Every canvas is as wide as its column and holds `span` model units, so the
// three are at one scale. On a wide page they are all as tall as the tallest
// animal; stacked on a narrow one, each is as tall as its own.
const MARGIN = 0.4;
const span = Math.max(...animals.map((a) => a.wide)) + MARGIN * 2;
const rise = Math.max(...animals.map((a) => a.tall)) + MARGIN * 2;
const canvas = (i: number) => ({
  "data-animal": animals[i].name,
  "data-size": animals[i].size,
  "data-span": span,
  "data-margin": MARGIN,
  style: `--all:${(span / rise).toFixed(4)};--own:${(span / (animals[i].tall + MARGIN * 2)).toFixed(4)}`,
});
const caption = (i: number) => `${animals[i].name}, ${animals[i].age}`;
---

<section class="evolution" id="evolution">
  <div class="wrap">
    <header>
      <h2>From a list of cells to a graph of files</h2>
      <p>
        The lobster's ancestors were smaller, plainer animals without claws. Data tools have grown the same way:
        each generation kept what worked and shed what hurt. Here is one five-step analysis in all three.
      </p>
    </header>

    <ol class="stages">
      <li>
        <div class="animal" aria-hidden="true">
          <canvas {...canvas(0)}></canvas>
          <span>{caption(0)}</span>
          <i data-ink></i><i data-shade></i>
        </div>
        <svg viewBox="0 0 320 284" role="img" aria-labelledby="ev-jupyter">
          <title id="ev-jupyter">
            A Jupyter notebook: five cells in one file, with execution counters out of order and their state held
            in a separate kernel.
          </title>
          <g class="tab">
            <rect x="12" y="10" width="138" height="24"></rect>
            <text x="20" y="27">analysis.ipynb</text>
          </g>
          {
            steps.map((s, i) => (
              <g>
                <text class="count" x="12" y={cellY(i) + 21}>{`[${counters[i]}]`}</text>
                <rect class="cell" x="46" y={cellY(i)} width="158" height="32" />
                <text class="code" x="56" y={cellY(i) + 21}>{`${s} = …`}</text>
                <path class="thread" d={`M204,${cellY(i) + 16} L246,${96 + i * 22}`} />
              </g>
            ))
          }
          <rect class="kernel" x="246" y="78" width="62" height="124"></rect>
          <text class="note" x="277" y="222" text-anchor="middle">kernel</text>
          {steps.map((_, i) => <circle class="var" cx="277" cy={96 + i * 22} r="4" />)}
        </svg>
        <h3>Jupyter</h3>
        <p class="what">Code, output and prose in one document.</p>
        <p>
          You can try an idea in seconds. But cells run in whatever order you run them, and the kernel remembers
          every result, so the file on disk and the state in memory drift apart.
        </p>
      </li>

      <li>
        <div class="animal" aria-hidden="true">
          <canvas {...canvas(1)}></canvas>
          <span>{caption(1)}</span>
          <i data-ink></i><i data-shade></i>
        </div>
        <svg viewBox="0 0 320 284" role="img" aria-labelledby="ev-marimo">
          <title id="ev-marimo">
            A marimo notebook: the same five cells in one Python file, joined by arrows that show which cell depends
            on which.
          </title>
          <defs>
            <marker id="ev-tip" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto">
              <path d="M0 0.5 7.5 4 0 7.5z"></path>
            </marker>
          </defs>
          <g class="tab">
            <rect x="12" y="10" width="112" height="24"></rect>
            <text x="20" y="27">analysis.py</text>
          </g>
          {
            steps.map((s, i) => (
              <g>
                <rect class="cell" x="12" y={cellY(i)} width="192" height="32" />
                <text class="code" x="22" y={cellY(i) + 21}>{`${s} = …`}</text>
              </g>
            ))
          }
          {
            arcs.map((a) => {
              const y1 = cellY(a.from) + (a.to - a.from > 1 ? 10 : 22);
              const y2 = cellY(a.to) + (a.to - a.from > 1 ? 22 : 10);
              return (
                <path
                  class="arc"
                  marker-end="url(#ev-tip)"
                  d={`M204,${y1} C${204 + a.reach * 1.3},${y1} ${204 + a.reach * 1.3},${y2} 208,${y2}`}
                />
              );
            })
          }
        </svg>
        <h3>marimo</h3>
        <p class="what">The notebook becomes a reactive graph.</p>
        <p>
          marimo reads which cells depend on which, re-runs the dependents when something changes, and saves the
          notebook as a plain Python file. The hidden state is gone, and the notebook fits in git.
        </p>
      </li>

      <li class="now">
        <div class="animal" aria-hidden="true">
          <canvas {...canvas(2)}></canvas>
          <span>{caption(2)}</span>
          <i data-ink></i><i data-shade></i>
        </div>
        <svg viewBox="0 0 320 284" role="img" aria-labelledby="ev-exuvia">
          <title id="ev-exuvia">
            An exuvia project: five node files laid out as a graph, each keeping its earlier outputs, one with its own
            schedule, an agent working on one of them, and a view that reads two of them.
          </title>
          <defs>
            <marker id="ev-tip-now" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto">
              <path d="M0 0.5 7.5 4 0 7.5z"></path>
            </marker>
          </defs>
          <g class="tab">
            <rect x="12" y="10" width="190" height="24"></rect>
            <text x="20" y="27">five files in nodes/</text>
          </g>
          {wires.map((d) => <path class="arc" marker-end="url(#ev-tip-now)" d={d} />)}
          {
            steps.map((s) => {
              const [x, y] = placed[s];
              return (
                <g>
                  <rect class="shed" x={x + 6} y={y + 6} width={W} height={H} />
                  <rect class="shed" x={x + 3} y={y + 3} width={W} height={H} />
                  <rect class="cell" x={x} y={y} width={W} height={H} />
                  <rect class="state" x={x} y={y} width="6" height={H} />
                  <text class="code" x={x + 14} y={y + 22}>{s === "summary" ? "summary.sql" : `${s}.py`}</text>
                </g>
              );
            })
          }
          <g class="view">
            <rect class="cell" x="16" y="236" width="282" height="38"></rect>
            <rect class="bar" x="16" y="236" width="282" height="9"></rect>
            <text class="code" x="26" y="264">views/vol_board/</text>
            {bars.map((h, i) => <rect class="mark" x={236 + i * 11} y={268 - h} width="7" height={h} />)}
          </g>
          <g class="clock" transform="translate(296 48)">
            <circle r="10"></circle>
            <path d="M0,-5 V0 L3.5,2.2"></path>
          </g>
          <g class="agent" transform="translate(96 126)">
            <path d="M22,24 L16,50"></path>
            <rect x="0" y="0" width="64" height="24"></rect>
            <text x="32" y="17" text-anchor="middle">agent</text>
          </g>
        </svg>
        <h3>exuvia</h3>
        <p class="what">The graph becomes the interface.</p>
        <p>
          Each node is its own file with its own schedule, and every run leaves a stored output behind. An AI agent
          reads, writes, runs and debugs nodes on the same canvas you work on, and a view turns their outputs into
          an app.
        </p>
      </li>
    </ol>
  </div>
</section>

<style>
  .evolution {
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: var(--border);
  }
  header {
    max-width: 46rem;
  }
  h2 {
    font-size: var(--step-3);
  }
  header p {
    max-width: 44rem;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  /* The animals stand on one line, so the diagrams below line up. */
  .animal {
    --poly-ink: var(--muted);
    --poly-shade: var(--line);
    padding-bottom: 0.9rem;
  }
  .now .animal {
    --poly-ink: var(--running);
    --poly-shade: #1c2c5e;
  }
  canvas {
    display: block;
    width: 100%;
    aspect-ratio: var(--all);
  }
  /* The canvas reads its two colours off these. */
  [data-ink] {
    color: var(--poly-ink);
  }
  [data-shade] {
    color: var(--poly-shade);
  }
  /* Each is named underneath, as the hero names its animals. */
  .animal span {
    display: block;
    margin-top: 0.35rem;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  @media (max-width: 900px) {
    canvas {
      aspect-ratio: var(--own);
    }
  }
</style>

<script>
  import { SWAY, build, extent, painter, stage, sway, tone } from "../lib/poly";

  const REST = -0.28; // as in the frontmatter above
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Sets one animal up on its canvas and returns the function that draws it, `life` seconds in. */
  function animal(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d")!;
    const { animal: name = "Homarus", size = "1", span = "20", margin = "0" } = canvas.dataset;
    const mesh = build(stage(name));
    const paint = painter(ctx, mesh);
    const box = extent(mesh.v, [REST - SWAY, REST, REST + SWAY]);
    const probe = canvas.parentElement!;
    const [ink, shade] = [tone(probe, "ink"), tone(probe, "shade")];

    return (life: number) => {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const ratio = Math.min(2, devicePixelRatio || 1);
      if (canvas.width !== Math.round(width * ratio) || canvas.height !== Math.round(height * ratio)) {
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
      }
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);
      // Stood on the bottom left corner.
      const unit = (width / Number(span)) * Number(size);
      const edge = (width / Number(span)) * Number(margin);
      paint.place(mesh.v, REST + (still ? 0 : sway(life)), unit, edge - box.left * unit, height - edge - box.bottom * unit);
      paint.solid(ink, shade);
    };
  }

  for (const root of document.querySelectorAll<HTMLElement>(".evolution")) {
    const draws = new Map<Element, (life: number) => void>();
    for (const canvas of root.querySelectorAll<HTMLCanvasElement>("canvas[data-animal]")) draws.set(canvas, animal(canvas));

    if (still) {
      // No motion: each at rest, redrawn when its canvas changes size.
      for (const [canvas, draw] of draws) new ResizeObserver(() => draw(0)).observe(canvas);
      continue;
    }
    // The three turn together, and only the ones on screen are drawn.
    const seen = new Set<Element>();
    let born = 0;
    let frame = 0;
    const tick = (now: number) => {
      born ||= now;
      for (const canvas of seen) draws.get(canvas)!((now - born) / 1000);
      frame = requestAnimationFrame(tick);
    };
    const watch = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.isIntersecting ? seen.add(entry.target) : seen.delete(entry.target);
      if (seen.size && !frame) frame = requestAnimationFrame(tick);
      if (!seen.size && frame) frame = (cancelAnimationFrame(frame), 0);
    });
    for (const canvas of draws.keys()) watch.observe(canvas);
  }
</script>
