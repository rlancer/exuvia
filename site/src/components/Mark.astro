---
// The exuvia mark: a lobster's claw in flat facets of the lobster's blue.
// With `flat` it is one shape in the colour of the text around it, for a
// place with one ink. Its shape and tones are in src/lib/brand.ts.
import { MARK, markBody } from "../lib/brand";

interface Props {
  size?: number;
  flat?: boolean;
}
const { size = 28, flat = false } = Astro.props;
---

<svg
  class="mark"
  width={size}
  height={size}
  viewBox={`0 0 ${MARK.box} ${MARK.box}`}
  aria-hidden="true"
  focusable="false"
  set:html={markBody(flat ? "currentColor" : undefined)}
/>
