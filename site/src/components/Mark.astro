---
// The exuvia mark: two paths that cross, the same shape as the app's icon,
// cut in black out of a solid block of the blue ink.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32"></rect>
  <path d="M7 9c8 0 10 14 18 14M7 23c8 0 10-14 18-14" stroke-width="3" fill="none" stroke-linecap="square"></path>
</svg>

<style>
  .mark rect {
    fill: var(--blue);
  }
  .mark path {
    stroke: var(--ink);
  }
</style>
