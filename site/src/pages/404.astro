---
import Base from "../layouts/Base.astro";
import { url } from "../lib/paths";
---

<Base title="Page not found | exuvia" description="This page does not exist.">
  <section class="wrap">
    <h1>This page does not exist</h1>
    <p>The address may be mistyped, or the page may have moved.</p>
    <p class="links">
      <a class="btn btn-primary" href={url("/")}>Go to the home page</a>
      <a class="btn btn-quiet" href={url("/docs/")}>Open the docs</a>
    </p>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(4rem, 14vw, 9rem);
  }
  h1 {
    font-size: var(--step-3);
  }
  p {
    margin-top: 1rem;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    color: var(--text);
  }
</style>
