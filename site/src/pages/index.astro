---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import HeroGraph from "../components/HeroGraph.astro";
import PolyMolts from "../components/PolyMolts.astro";
import Sea from "../components/Sea.astro";
import Evolution from "../components/Evolution.astro";
import NodeAnatomy from "../components/NodeAnatomy.astro";
import Workbench from "../components/Workbench.astro";
import ViewAnatomy from "../components/ViewAnatomy.astro";
import Compare from "../components/Compare.astro";
import Workflows from "../components/Workflows.astro";
import agentPanel from "../assets/shots/agent-panel.png";
import { agentDeployPrompt, agentSetupPrompt } from "../lib/docs";
import { codeFigure, copyButton, getHighlighter } from "../lib/highlight";
import { url } from "../lib/paths";

const h = await getHighlighter();
const handoffs = [
  {
    id: "local",
    label: "On your machine",
    body: "Paste this into Claude Code, Cursor, Codex, Grok or any coding agent with a terminal. It installs exuvia, creates a project, starts the workbench and connects itself to the graph. No model key is needed: the model is the one your agent already runs on.",
    href: "/docs/agent-setup/",
    prompt: codeFigure(h, agentSetupPrompt(), "text"),
  },
  {
    id: "server",
    label: "On a server",
    body: "Paste this into an agent that can reach your Docker host or Kubernetes cluster, a cloud VM or GKE, EKS or AKS, leave Docker or Kubernetes on the first line, whichever you use, and put your hostname on the second. On Docker it uses Swarm when the host is a Swarm manager and Compose otherwise. It deploys a hub from the published image behind a generated API token, puts it on your hostname with TLS, checks it end to end, then creates a project, connects itself to it and hands you the project's workbench URL.",
    href: "/docs/deploying/#hand-it-to-an-agent",
    prompt: codeFigure(h, agentDeployPrompt(), "text"),
  },
];

const providers = [
  { name: "Claude", set: ["ANTHROPIC_API_KEY"] },
  { name: "Any model on OpenRouter", set: ["OPENROUTER_API_KEY"] },
  { name: "A local or self-hosted model", set: ["EXUVIA_BASE_URL", "EXUVIA_MODEL"] },
];

// Against the two ways people already do analysis with a model: asking a chat
// that has data connectors, and having a coding agent build it from nothing.
const aiComparison = [
  [
    "How the answer is made",
    "Tool calls, and whatever fits in one conversation",
    "Code the agent writes and runs",
    "Code the agent writes and runs, as nodes in a graph",
  ],
  [
    "Running it again",
    "Ask again and get a different answer",
    "Rerun whatever scripts it left, in the right order",
    "Run any node, by hand or on a schedule. What it depends on runs first",
  ],
  [
    "Last week's numbers",
    "Somewhere in a transcript",
    "Overwritten, unless you built storage for them",
    "Kept: one output per run date, and a table of every run to query",
  ],
  [
    "The interface",
    "A reply in the chat",
    "A dashboard app per analysis: a backend that loads the data and a front end that shows it",
    "A view: front-end files that read stored outputs. There is no backend to write",
  ],
  [
    "What you are left with",
    "A conversation",
    "One more app to host and keep running",
    "Plain files in one project, with every version kept",
  ],
];

const comparison = [
  ["Unit of work", "A cell", "A task or an asset", "A node file"],
  ["Dependencies", "Hidden state, or reactive cells", "Declared in code", "Function parameters and SQL table names"],
  ["Scheduling", "None", "The whole DAG, or asset jobs", "Per node, by cron, cascading downstream"],
  ["Iteration loop", "Fast", "Slow: deploy first", "Fast: edit, run, see the data"],
  [
    "Custom UI",
    "Widgets and HTML built from Python",
    "None: you build a separate app",
    "Views: TypeScript, React and CSS in files of their own",
  ],
  ["On disk", "Notebook JSON", "A Python package", "One plain file per node"],
];

const more = [
  {
    title: "Run parameters and replays",
    href: "/docs/run-parameters/",
    body: "Run the graph for a date and keep one output per date. Replay a range, and query every run of a node as one table.",
  },
  {
    title: "Many projects, one process",
    href: "/docs/hub/",
    body: "Serve every project under one directory from a single process.",
  },
  {
    title: "Remote executors",
    href: "/docs/architecture/",
    body: "Keep the control plane on your laptop and run nodes in a container on Cloud Run, Fly, Kubernetes or Cloudflare.",
  },
  {
    title: "Your storage",
    href: "/docs/records/",
    body: "Outputs go to disk or any S3-compatible bucket. Run history goes to SQLite or Postgres.",
  },
  {
    title: "Headless runs",
    href: "/docs/command-line/",
    body: "<code>exuvia run</code> brings a project up to date and exits non-zero when a node fails, so it fits CI and cron.",
  },
  {
    title: "An HTTP API",
    href: "/docs/http-api/",
    body: "Everything the UI does is a plain HTTP call, with Arrow streams and Parquet files when you want the data itself.",
  },
];

const steps = [
  {
    title: "Install it",
    body: "exuvia is one Python package with the web UI inside. uv and pipx give it an environment of its own, and pip works too.",
    code: codeFigure(h, "uv tool install exuvia    # or: pipx install exuvia", "bash"),
  },
  {
    title: "Create a project and open it",
    body: "A project is a folder. This makes one with a first node, then serves the workbench at 127.0.0.1:7420.",
    code: codeFigure(h, "exuvia init my-research\nexuvia serve my-research", "bash"),
  },
  {
    title: "Add a node",
    body: "Save a file in nodes/. The parameter name is the dependency. The canvas picks the file up by itself.",
    code: codeFigure(
      h,
      `import exuvia\n\n\n@exuvia.node()\ndef squares(hello):\n    return hello[hello["y"] > 1]`,
      "python",
      "nodes/squares.py",
    ),
  },
  {
    title: "Turn on the agent",
    body: "Put a model key in the project's .env and restart. Then ask for a node, a fix or a chart.",
    code: codeFigure(h, `echo "ANTHROPIC_API_KEY=sk-ant-..." >> my-research/.env`, "bash"),
  },
];
---

<Base
  title="exuvia: a data workbench where the graph is the interface"
  description="exuvia turns an analysis into a graph of plain Python and SQL files, with per-node schedules, stored outputs and an AI agent that works on the graph with you."
  current="home"
>
  <Sea />
  <section class="hero">
    <div class="wrap hero-top">
      <div class="pitch">
        <h1>A data workbench where the graph is the interface</h1>
        <p class="lede">
          exuvia turns an analysis into a graph of plain Python and SQL files. Schedule any node on its own, keep
          every output it produces, and work with an AI agent that reads, writes, runs and debugs the graph
          alongside you.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={url("/docs/getting-started/")}>Get started</a>
          <div class="install" data-code>
            <pre class="mono"><span aria-hidden="true">$ </span>pip install exuvia</pre>
            <Fragment set:html={copyButton("pip install exuvia")} />
          </div>
        </div>
        <p class="handoff-link">
          Or <a href="#agent-setup">paste one prompt into your coding agent</a> and let it do the setup, on your
          machine or on a server.
        </p>
      </div>
      <figure class="specimen">
        <PolyMolts />
        <figcaption>
          <dfn>exuvia</dfn>, <i>noun.</i> The shell a lobster leaves behind when it molts. Every run of a node
          leaves one too: an output you can go back to.
        </figcaption>
      </figure>
    </div>
    <div class="wrap">
      <HeroGraph />
    </div>
  </section>

  <Evolution />
  <NodeAnatomy />
  <Workbench />
  <ViewAnatomy />

  <section class="agent" id="agent">
    <div class="wrap agent-grid">
      <div>
        <h2>An agent with tools over the graph</h2>
        <p class="intro">
          The agent is not a chat box beside your work. It has the same handles you do: it lists and reads nodes,
          writes them, runs them, and queries their outputs with DuckDB. What it builds is not an answer in a
          transcript but a pipeline you can run again tomorrow.
        </p>
        <ul class="habits">
          <li>It looks at the real column names before it writes a line.</li>
          <li>It runs what it writes, and reads the traceback when a run fails.</li>
          <li>Every tool call shows in the conversation, and the nodes it touches flash on the canvas.</li>
          <li>What it leaves behind are ordinary files, with every earlier version kept and restorable.</li>
        </ul>

        <h3>Bring your own model</h3>
        <table class="providers">
          <thead>
            <tr><th scope="col">Model</th><th scope="col">Set</th></tr>
          </thead>
          <tbody>
            {
              providers.map((p) => (
                <tr>
                  <th scope="row">{p.name}</th>
                  <td>
                    {p.set.map((name, i) => (
                      <>
                        {i > 0 && " and "}
                        <code>{name}</code>
                      </>
                    ))}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="aside">
          The model needs to support function calling. <a href={url("/docs/agent/")}>Providers, project notes and sessions</a>
        </p>
      </div>

      <figure class="transcript">
        <div class="clip">
          <Image
            src={agentPanel}
            alt="An agent conversation. The request: add a drawdown node per ticker with a chart. Its steps: looked at the graph, read prices, wrote drawdown in 20 lines, ran drawdown for 2,080 rows. Then a summary of the new node."
            widths={[340, 678]}
            sizes="340px"
            loading="lazy"
          />
        </div>
        <figcaption>A real turn on the example project, with DeepSeek through OpenRouter.</figcaption>
      </figure>
    </div>
  </section>

  <section class="between" id="ai">
    <div class="wrap">
      <header>
        <h2>Between a chat answer and a one-off app</h2>
        <p>
          There are two usual ways to do an analysis with a model, and each gives something up. exuvia gives the
          agent a place to build instead. Here is one analysis done all three ways.
        </p>
      </header>
      <Workflows />
      <Compare
        label="exuvia beside AI chat and coding agents"
        columns={["AI chat with connectors", "A coding agent on its own", "exuvia"]}
        rows={aiComparison}
      />
      <p class="keep">
        You keep the agent you already use. exuvia's tools are an <a href={url("/docs/mcp/")}>MCP server</a>, so
        Claude Code, Cursor or Codex builds in the graph instead of in an empty repo.
        <a href={url("/docs/run-parameters/")}>Run parameters and replays</a> are what make a run a point in time
        you can go back to.
      </p>
    </div>
  </section>

  <section class="between" id="compare">
    <div class="wrap">
      <header>
        <h2>Between a notebook and an orchestrator</h2>
        <p>
          Notebooks are quick to work in and awkward to run every day. Orchestrators run every day and are slow to
          work in. exuvia keeps the notebook's loop and gives each node the orchestrator's schedule.
        </p>
      </header>
      <Compare label="exuvia beside notebooks and orchestrators" columns={["Notebooks", "Orchestrators", "exuvia"]} rows={comparison} />

      <h3 class="more-title">When the project outgrows your laptop</h3>
      <dl class="more">
        {
          more.map((item) => (
            <div>
              <dt>
                <a href={url(item.href)}>{item.title}</a>
              </dt>
              <dd set:html={item.body} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="start reverse" id="get-started">
    <div class="wrap">
      <header>
        <h2>Running in four steps</h2>
        <p>From an empty folder to a graph with an agent on it.</p>
      </header>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <div class="step-text">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
              <Fragment set:html={step.code} />
            </li>
          ))
        }
      </ol>
      <div class="handoff" id="agent-setup" data-tabs>
        <div class="handoff-head">
          <h3>Or hand the setup to your agent</h3>
          <div class="tablist" role="tablist" aria-label="Where to set up exuvia">
            {
              handoffs.map((item, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`handoff-tab-${item.id}`}
                  aria-controls={`handoff-${item.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {item.label}
                </button>
              ))
            }
          </div>
        </div>
        {
          handoffs.map((item, i) => (
            <div
              class="handoff-panel"
              role="tabpanel"
              id={`handoff-${item.id}`}
              aria-labelledby={`handoff-tab-${item.id}`}
              hidden={i !== 0}
            >
              <div class="handoff-text">
                <p>{item.body}</p>
                <a href={url(item.href)}>What the prompt does</a>
              </div>
              <Fragment set:html={item.prompt} />
            </div>
          ))
        }
      </div>
      <div class="next">
        <a class="btn btn-primary" href={url("/docs/getting-started/")}>Follow the full tutorial</a>
        <p>
          exuvia is an early release. <a href={url("/docs/status/")}>See what it does not do yet.</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero --------------------------------------------------------------- */
  .hero {
    padding: clamp(2rem, 5vw, 3.75rem) 0 clamp(3.5rem, 7vw, 5.5rem);
  }
  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  h1 {
    font-size: var(--step-4);
    line-height: 1.06;
  }
  .lede {
    max-width: 36rem;
    margin-top: 1.6rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0 0.4rem 0 1rem;
    border: var(--border-strong);
    border-radius: 0.5rem;
    background: var(--panel);
  }
  .install pre {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .install pre span {
    color: var(--accent);
  }
  .install :global(.copy) {
    border-color: transparent;
    background: transparent;
    color: var(--text);
  }
  .install :global(.copy[data-state="copied"]) {
    color: var(--fresh);
  }
  .install :global(.copy:not([data-state="copied"]):hover) {
    background: var(--text);
    color: var(--bg);
  }
  .handoff-link {
    margin-top: 1.1rem;
    color: var(--muted);
  }
  .handoff-link a {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .specimen {
    margin: 0;
  }
  .specimen figcaption {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: var(--border);
    color: var(--muted);
    line-height: 1.4;
  }
  .specimen dfn {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1.25rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  /* ---- shared section headers -------------------------------------------- */
  section > .wrap > header,
  .agent h2 {
    max-width: 46rem;
  }
  h2 {
    font-size: var(--step-3);
  }
  section > .wrap > header p {
    max-width: 44rem;
    margin-top: 1.1rem;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  /* ---- agent -------------------------------------------------------------- */
  .agent {
    padding: clamp(4rem, 9vw, 7rem) 0;
  }
  .agent-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .intro {
    max-width: 38rem;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .habits {
    display: grid;
    gap: 0.5rem;
    max-width: 38rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .habits li {
    padding-left: 1.6rem;
    background: linear-gradient(var(--accent), var(--accent)) 0 0.7em / 0.9rem 2px no-repeat;
  }
  .agent h3 {
    margin-top: 2.75rem;
    font-size: 1.5rem;
  }
  .providers {
    width: 100%;
    max-width: 38rem;
    margin-top: 0.75rem;
    border-collapse: collapse;
    text-align: left;
  }
  .providers th,
  .providers td {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 400;
  }
  .providers thead th {
    border-bottom: var(--border);
    color: var(--muted);
    font-weight: 600;
  }
  .providers td {
    padding-left: 1rem;
  }
  .providers td,
  .providers thead th:last-child {
    text-align: right;
  }
  .aside {
    max-width: 38rem;
    margin-top: 0.9rem;
    color: var(--muted);
  }
  .transcript {
    margin: 0;
  }
  .clip {
    max-height: 572px;
    border: var(--border-strong);
    border-radius: 0.6rem;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .clip :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .transcript figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  /* ---- comparison --------------------------------------------------------- */
  .between {
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: var(--border);
    background: var(--band);
  }
  .between header p {
    color: var(--muted);
  }
  .keep {
    max-width: 44rem;
    margin-top: 1.75rem;
    color: var(--muted);
  }
  .keep a {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .more-title {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 1.5rem;
  }
  .more {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin: 1.25rem 0 0;
  }
  .more div {
    padding: 0.9rem 0 1.2rem;
    border-top: var(--border);
  }
  .more dt {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .more a {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .more dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  /* ---- get started -------------------------------------------------------- */
  .start {
    padding: clamp(4rem, 9vw, 7rem) 0;
  }
  .start header p {
    color: var(--muted);
  }
  .steps {
    display: grid;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem 3rem;
    align-items: center;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    counter-increment: step;
  }
  .step-text {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
  }
  .step-text::before {
    content: counter(step);
    grid-row: span 2;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 0.9;
  }
  .steps h3 {
    font-size: 1.3rem;
  }
  .steps p {
    margin-top: 0.3rem;
    color: var(--muted);
  }
  .handoff {
    padding: 2rem 0 0.5rem;
    border-top: var(--border-strong);
    scroll-margin-top: 5rem;
  }
  .handoff-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.25rem;
  }
  .handoff h3 {
    font-size: 1.5rem;
  }
  .handoff-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1.5rem 3rem;
    align-items: start;
  }
  .handoff-panel[hidden] {
    display: none;
  }
  .tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* The same segmented control as the workbench screenshots. */
  [role="tab"] {
    padding: 0.3rem 0.9rem 0.35rem;
    border: var(--border-strong);
    border-radius: 0.45rem;
    background: transparent;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  [role="tab"]:hover {
    background: var(--panel);
  }
  [role="tab"][aria-selected="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .handoff p {
    margin-top: 0.5rem;
    color: var(--muted);
  }
  .handoff a {
    display: inline-block;
    margin-top: 0.75rem;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.5rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero-top {
      grid-template-columns: minmax(0, 1fr);
    }
    .specimen {
      max-width: 28rem;
    }
    .agent-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .transcript {
      max-width: 340px;
    }
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps li,
    .handoff-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
