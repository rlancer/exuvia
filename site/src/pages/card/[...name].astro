---
// The source of the social cards (src/lib/cards.ts): /card/<name>/ is one
// card at its real size, 1200 x 630, and /card/ is all of them on one sheet.
// `bun tools/capture.mjs cards <site url>` photographs each into
// public/og/<name>.png. These pages exist only under `astro dev`: a build
// makes none of them.
//
// A card has no words on it: one picture, in the middle, so that it still
// reads when a site crops the card or shows it as a thumbnail.
//
// /card/<lockup>/ is the mark beside the name on nothing at all, which the
// same command saves as a see-through PNG in public/brand/.
import "../../styles/global.css";
import CardSea from "../../components/CardSea.astro";
import Mark from "../../components/Mark.astro";
import { APP_PALETTE, LOBSTER, SIGNALS } from "../../lib/brand";
import { CARD, LOCKUPS, getCards, type Card, type Lockup } from "../../lib/cards";
import { url } from "../../lib/paths";
import { STAGES } from "../../lib/poly";
import { polySvg } from "../../lib/polysvg";

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [
    { params: { name: undefined }, props: {} },
    ...(await getCards()).map((card) => ({ params: { name: card.name }, props: { card } })),
    ...LOCKUPS.map((lockup) => ({ params: { name: lockup.name }, props: { lockup } })),
  ];
}

interface Props {
  card?: Card;
  lockup?: Lockup;
}
const { card, lockup } = Astro.props;
const sheet = card || lockup ? [] : await getCards();
const look = card ? ["card", card.look] : lockup ? ["plate"] : ["sheet"];

// The lobster, lit; and an animal as the shell it left.
const lobster = (unit: number) => polySvg("Homarus", { unit, solid: LOBSTER }).svg;
const shell = (name: string, size: { unit?: number; fit?: number }, width = 1.5) => polySvg(name, { ...size, lineWidth: width });
// One shell as big as the card has room for: the animals are not all one shape.
const ROOM = { width: 960, height: 450 };
function whole(name: string) {
  const wide = shell(name, { fit: ROOM.width }, 2);
  return wide.height <= ROOM.height ? wide.svg : shell(name, { fit: (ROOM.width * ROOM.height) / wide.height }, 2).svg;
}
const swatches = [...SIGNALS, ...APP_PALETTE.filter((s) => ["--text", "--muted", "--line-strong", "--panel-2", "--bg-deep"].includes(s.token))];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{card ? `Card: ${card.name}` : lockup ? `Lockup: ${lockup.name}` : "Social cards"}</title>
  </head>

  <body class:list={look} style={lockup && `--ink:${lockup.ink}`}>
    {
      lockup && (
        <div class="lockup" data-shot>
          <Mark size={134} flat={lockup.flat} />
          <span>exuvia</span>
        </div>
      )
    }

    {
      card && (
        <>
        {card.look === "sea" && <CardSea />}
        {card.look === "sea" && <div class="art" set:html={lobster(44)} />}
        {
          card.look === "docs" && (
            <div class="art molts">
              <ol>
                {STAGES.slice(0, -1).map((s) => (
                  <li set:html={shell(s.name, { unit: 11 }, 1.6).svg} />
                ))}
              </ol>
              <Fragment set:html={lobster(34)} />
            </div>
          )
        }
        {card.look === "group" && <div class="art outline" set:html={whole(card.animal)} />}
        {
          card.look === "brand" && (
            <div class="art plate-art">
              <Mark size={300} />
              <ul>
                {swatches.map((s) => (
                  <li style={`background:${s.value}`} />
                ))}
              </ul>
            </div>
          )
        }
        </>
      )
    }

    {
      !card && !lockup && (
        <>
        <h1>Social cards</h1>
        <p>
          Each is a page at its real size. <code>node tools/capture.mjs cards {Astro.url.origin}</code> saves them to
          <code>public/og/</code>, and the lockups to <code>public/brand/</code>.
        </p>
        <ul>
          {sheet.map((c) => (
            <li>
              <a href={url(`/card/${c.name}/`)} data-card={c.name}>
                {c.name}
              </a>
              <div class="frame">
                <iframe src={url(`/card/${c.name}/`)} width={CARD.width} height={CARD.height} title={c.name} loading="lazy" />
              </div>
            </li>
          ))}
          {LOCKUPS.map((l) => (
            <li>
              <a href={url(`/card/${l.name}/`)} data-lockup={l.name}>
                {l.name}
              </a>
            </li>
          ))}
        </ul>
        </>
      )
    }
  </body>
</html>

<style is:global>
  /* ---- one card ----------------------------------------------------------- */
  body.card {
    position: relative;
    display: grid;
    place-items: center;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }
  .card .art svg {
    display: block;
    max-width: none;
  }

  /* The docs' cards are on the app's canvas, in the app's palette. */
  .card .molts {
    display: grid;
    justify-items: center;
    gap: 34px;
  }
  .molts ol {
    display: flex;
    align-items: flex-end;
    gap: 44px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }
  .card .outline {
    color: var(--muted);
  }
  .card .plate-art {
    display: grid;
    justify-items: center;
    gap: 44px;
  }
  .plate-art ul {
    display: grid;
    grid-template-columns: repeat(8, 56px);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plate-art li {
    height: 56px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
  }

  /* ---- a lockup: the mark and the name, on nothing ------------------------ */
  body.plate {
    width: max-content;
    padding: 40px;
    background: none;
  }
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 42px;
    padding: 30px 40px;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 112px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  /* ---- the sheet ---------------------------------------------------------- */
  body.sheet {
    padding: 2rem;
  }
  .sheet ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, 400px);
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .sheet .frame {
    width: 400px;
    height: 210px;
    margin-top: 0.4rem;
    overflow: hidden;
    border: var(--border-strong);
  }
  .sheet iframe {
    border: 0;
    transform: scale(0.3333);
    transform-origin: 0 0;
  }
</style>
